---
import Socials from './Socials.astro';
import { links } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="footer-note">© {year} · <span id="footer-note">Product design for web, mobile, and SaaS</span></p>
  <div class="footer-end">
    <a class="footer-mail" href={`mailto:${links.email}`}>{links.email}</a>
    <Socials tone="light" />
  </div>
</footer>

<script>
  const notes = [
    'Product design for web, mobile, and SaaS',
    'Selected case studies live on this site',
    'Remote, and close to the team',
  ];
  const note = document.getElementById('footer-note');
  if (note) note.textContent = notes[Math.floor(Math.random() * notes.length)];
</script>
