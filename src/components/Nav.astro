---
import { sitePath } from '../lib/asset';

interface Props {
  contactHref?: string;
}

const base = import.meta.env.BASE_URL;
const { contactHref = sitePath('#contact', base) } = Astro.props;
---

<nav aria-label="Primary">
  <div class="nav-inner">
    <a class="name" href={sitePath('/', base)}>Omar Faruk</a>
    <div class="links">
      <a href={sitePath('#work', base)}>Work</a>
      <a href={sitePath('#approach', base)}>About</a>
      <a href={sitePath('#experience', base)}>Experience</a>
      <a class="cta" href={contactHref}>Get in touch</a>
    </div>
  </div>
</nav>
