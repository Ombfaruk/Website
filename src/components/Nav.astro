---
import { sitePath } from '../lib/asset';

const base = import.meta.env.BASE_URL;
---

<nav aria-label="Primary">
  <div class="nav-inner">
    <a class="name" href={sitePath('/', base)}>Omar Faruk</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" data-nav-toggle>
      Menu
    </button>
    <div class="nav-links" id="nav-links" data-nav-links>
      <a href={sitePath('#work', base)}>Work</a>
      <a href={sitePath('#services', base)}>Services</a>
      <a href={sitePath('#about', base)}>About</a>
      <a class="nav-cta" href={sitePath('#contact', base)}>Contact</a>
    </div>
  </div>
</nav>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const links = document.querySelector<HTMLElement>('[data-nav-links]');
  if (button && links) {
    const close = () => {
      links.classList.remove('is-open');
      button.setAttribute('aria-expanded', 'false');
      button.textContent = 'Menu';
    };
    button.addEventListener('click', () => {
      const open = links.classList.toggle('is-open');
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open ? 'Close' : 'Menu';
    });
    links.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('a')) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }
</script>
