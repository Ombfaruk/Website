---
import { links } from '../data/site';

interface Props {
  tone?: 'dark' | 'light';
}

const { tone = 'dark' } = Astro.props;
---

<div class:list={['socials', tone === 'light' && 'socials-light']}>
  <a class="social social-x" href={links.x} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 4.5h3.1l4.2 5.7L15.8 4.5H20l-6.2 7.1L20.2 19.5h-3.1l-4.6-6.2-4.7 6.2H4.2l6.6-7.6L4 4.5Z" />
    </svg>
    <span class="visually-hidden">X</span>
  </a>
  <a class="social social-in" href={links.linkedin} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5.7 9.2H8.2V19H5.7V9.2ZM6.9 4.5c.8 0 1.5.7 1.5 1.5S7.7 7.5 6.9 7.5 5.4 6.8 5.4 6s.7-1.5 1.5-1.5ZM10.2 9.2h2.4v1.3h.1c.3-.6 1.2-1.3 2.5-1.3 2.6 0 3.1 1.7 3.1 4V19h-2.5v-5.1c0-1.2 0-2.8-1.7-2.8s-1.9 1.3-1.9 2.7V19H10.2V9.2Z" />
    </svg>
    <span class="visually-hidden">LinkedIn</span>
  </a>
  <a class="social social-db" href={links.dribbble} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3.2a8.8 8.8 0 1 0 0 17.6 8.8 8.8 0 0 0 0-17.6Zm5.9 4.2a7.5 7.5 0 0 1 1.5 3.2c-1.3-.2-2.6-.3-3.8-.2-.2-.6-.5-1.2-.8-1.8.9-.6 2-1 3.1-1.2ZM14.3 6c-.5.6-1 1.3-1.4 2-1.5-.2-3.1-.2-4.7 0A7.6 7.6 0 0 1 12 4.4c.8.5 1.6 1 2.3 1.6ZM8.4 8.4c1.7-.2 3.4-.2 5 .1-.4.8-.7 1.6-.9 2.4-1.8-.5-3.8-.6-5.7-.2.4-.9.9-1.7 1.6-2.3ZM4.6 12.2c2.1-.5 4.3-.4 6.3.2-.1.3-.2.6-.3.9-2.2.7-4.1 2-5.6 3.8a7.5 7.5 0 0 1-.4-4.9Zm2.2 5.6c1.4-1.6 3.2-2.8 5.2-3.5.5 1.3.8 2.6.9 4a7.5 7.5 0 0 1-6.1-.5Zm6.6.2c-.1-1.3-.4-2.6-.9-3.8 1.4-.2 2.9-.2 4.4.1a7.5 7.5 0 0 1-3.5 3.7Z" />
    </svg>
    <span class="visually-hidden">Dribbble</span>
  </a>
  <a class="social social-mail" href={`mailto:${links.email}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4.5 7.2h15v9.6h-15V7.2Zm1.2 1.2v.5l6.3 4 6.3-4v-.5H5.7Zm12.6 7.2V10.4l-6.3 4-6.3-4v5.2h12.6Z" />
    </svg>
    <span class="visually-hidden">Email</span>
  </a>
</div>
