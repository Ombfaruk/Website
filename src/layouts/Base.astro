---
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/manrope/800.css';
import '@fontsource/outfit/700.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { siteConfig } from '../config';
import { asset } from '../lib/asset';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  ogType?: string;
  noindex?: boolean;
  bare?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  image,
  imageAlt = 'Portrait of Omar Faruk',
  ogType = 'website',
  noindex = false,
  bare = false,
  jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL(siteConfig.site);
const canonical = new URL(Astro.url.pathname, site);
const imagePath = image ?? asset('/images/omar-headshot.jpg', base);
const ogImage = new URL(imagePath, site);
const json = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
const fullTitle = title.includes('Omar Faruk') ? title : `${title} · Omar Faruk`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Omar Faruk" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={asset('/favicon.svg', base)} type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <link rel="sitemap" type="application/xml" href={asset('/sitemap-index.xml', base)} />
    {json ? <script type="application/ld+json" set:html={json} /> : null}
  </head>
  <body class={bare ? 'is-admin' : undefined}>
    <a class="skip" href="#content">Skip to content</a>
    {
      bare ? (
        <main id="content">
          <slot />
        </main>
      ) : (
        <>
          <Nav />
          <svg class="clip-defs" width="0" height="0" aria-hidden="true">
            <defs>
              <clipPath id="scallop" clipPathUnits="objectBoundingBox">
                <path d="M 0.5000 0.1000 L 0.5203 0.0730 L 0.5426 0.0544 L 0.5648 0.0496 L 0.5847 0.0605 L 0.6008 0.0846 L 0.6127 0.1162 L 0.6218 0.1480 L 0.6310 0.1729 L 0.6433 0.1862 L 0.6615 0.1868 L 0.6862 0.1774 L 0.7163 0.1635 L 0.7480 0.1518 L 0.7767 0.1481 L 0.7980 0.1561 L 0.8089 0.1760 L 0.8094 0.2050 L 0.8023 0.2381 L 0.7928 0.2697 L 0.7870 0.2956 L 0.7902 0.3135 L 0.8052 0.3238 L 0.8311 0.3293 L 0.8639 0.3338 L 0.8969 0.3411 L 0.9230 0.3536 L 0.9366 0.3718 L 0.9350 0.3945 L 0.9198 0.4191 L 0.8959 0.4431 L 0.8708 0.4646 L 0.8520 0.4832 L 0.8450 0.5000 L 0.8520 0.5168 L 0.8708 0.5354 L 0.8959 0.5569 L 0.9198 0.5809 L 0.9350 0.6055 L 0.9366 0.6282 L 0.9230 0.6464 L 0.8969 0.6589 L 0.8639 0.6662 L 0.8311 0.6707 L 0.8052 0.6762 L 0.7902 0.6865 L 0.7870 0.7044 L 0.7928 0.7303 L 0.8023 0.7619 L 0.8094 0.7950 L 0.8089 0.8240 L 0.7980 0.8439 L 0.7767 0.8519 L 0.7480 0.8482 L 0.7163 0.8365 L 0.6862 0.8226 L 0.6615 0.8132 L 0.6433 0.8138 L 0.6310 0.8271 L 0.6218 0.8520 L 0.6127 0.8838 L 0.6008 0.9154 L 0.5847 0.9395 L 0.5648 0.9504 L 0.5426 0.9456 L 0.5203 0.9270 L 0.5000 0.9000 L 0.4823 0.8721 L 0.4665 0.8508 L 0.4509 0.8415 L 0.4333 0.8460 L 0.4122 0.8620 L 0.3873 0.8838 L 0.3602 0.9040 L 0.3336 0.9156 L 0.3110 0.9139 L 0.2949 0.8979 L 0.2862 0.8702 L 0.2837 0.8365 L 0.2839 0.8034 L 0.2822 0.7770 L 0.2741 0.7607 L 0.2568 0.7550 L 0.2304 0.7571 L 0.1977 0.7619 L 0.1640 0.7643 L 0.1354 0.7597 L 0.1172 0.7460 L 0.1123 0.7238 L 0.1200 0.6959 L 0.1361 0.6662 L 0.1542 0.6384 L 0.1670 0.6152 L 0.1690 0.5972 L 0.1576 0.5831 L 0.1342 0.5705 L 0.1041 0.5569 L 0.0744 0.5406 L 0.0529 0.5213 L 0.0450 0.5000 L 0.0529 0.4787 L 0.0744 0.4594 L 0.1041 0.4431 L 0.1342 0.4295 L 0.1576 0.4169 L 0.1690 0.4028 L 0.1670 0.3848 L 0.1542 0.3616 L 0.1361 0.3338 L 0.1200 0.3041 L 0.1123 0.2762 L 0.1172 0.2540 L 0.1354 0.2403 L 0.1640 0.2357 L 0.1977 0.2381 L 0.2304 0.2429 L 0.2568 0.2450 L 0.2741 0.2393 L 0.2822 0.2230 L 0.2839 0.1966 L 0.2837 0.1635 L 0.2862 0.1298 L 0.2949 0.1021 L 0.311