---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Socials from '../components/Socials.astro';
import { siteConfig } from '../config';
import { bio, heroLines, links } from '../data/site';
import { parseCaseStudy } from '../lib/caseStudy';
import { asset, sitePath } from '../lib/asset';
import { clientLabel, firstParagraph, studyYear } from '../lib/excerpts';
import { publishedWork } from '../lib/work';

const base = import.meta.env.BASE_URL;
const studies = publishedWork(await getCollection('work')).map((study) => {
  const body = study.filePath ? parseCaseStudy(fs.readFileSync(study.filePath, 'utf8')).body : '';
  return { ...study, story: body };
});
const pageUrl = new URL(sitePath('/', base), siteConfig.site).href;
const portrait = new URL(asset('/images/omar-headshot.jpg', base), siteConfig.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Omar Faruk',
      jobTitle: 'Product designer',
      email: `mailto:${links.email}`,
      url: pageUrl,
      image: portrait,
      sameAs: [links.x, links.linkedin, links.dribbble],
    },
    { '@type': 'WebSite', name: 'Omar Faruk', url: pageUrl },
  ],
};

function cardText(body: string) {
  const paragraph = firstParagraph(body);
  if (paragraph.length <= 280) return paragraph;
  const cut = paragraph.slice(0, 280);
  const space = cut.lastIndexOf(' ');
  return `${(space > 80 ? cut.slice(0, space) : cut).replace(/[.,;:]+$/, '')}.`;
}
---

<Base
  title="Omar Faruk, product designer"
  description="Omar Faruk is a product designer for enterprise SaaS, web apps, mobile apps, and websites. He makes complex products easier to use and easier to grow."
  jsonLd={jsonLd}
>
  <section class="jumbotron">
    <div class="left">
      <div class="rise">
        <h1>Hello, I'm Omar</h1>
        <h2 class="jumbo-line">
          <span class="rotator" id="hero-rotator" data-lines={JSON.stringify(heroLines)}>
            <span class="rotator-line">{heroLines[0]}</span>
          </span>
        </h2>
      </div>
      <div class="job-row rise" style="animation-delay: 120ms">
        <div>
          <h3>Currently</h3>
          <h4>Freelance product designer</h4>
        </div>
        <div>
          <h3>Previously at</h3>
          <h4>Jiak, Roofer.com & RoBenDevs</h4>
        </div>
      </div>
    </div>
    <div class="right">
      <img
        class="portrait rise"
        style="animation-delay: 180ms"
        src={asset('/images/omar-headshot.jpg', base)}
        alt="Portrait of Omar Faruk"
        width="1024"
        height="1024"
      />
      <div class="hello rise" style="animation-delay: 240ms">
        <h3>Nice to meet you</h3>
        <h4>{bio[0]}</h4>
      </div>
      <div class="rise" style="animation-delay: 320ms">
        <Socials />
      </div>
    </div>
  </section>

  <div class="root-container" id="work">
    <div class="home-card-container">
      {
        studies.map((study, index) => {
          const year = studyYear(study.data.timeline);
          const tags = [clientLabel(study.data.client), 'Case study', year].filter(Boolean);
          const href = sitePath(`/work/${study.id}/`, base);
          return (
            <a class="project-card rise" style={`animation-delay: ${180 + index * 90}ms`} href={href}>
              <div class="preview">
                {study.data.coverType === 'video' ? (
                  <video src={asset(study.data.cover, base)} muted playsinline loop autoplay></video>
                ) : (
                  <img src={asset(study.data.cover, base)} alt={study.data.coverAlt || study.data.title} />
                )}
              </div>
              <div class="card-copy">
                <h3>{study.data.title}</h3>
                <p>{cardText(study.story || study.data.outcome)}</p>
                <div class="project-context">
                  {tags.map((tag) => (
                    <>
                      <h4>{tag}</h4>
                      <h4 class="dot">·</h4>
                    </>
                  ))}
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</Base>

<script>
  const rotator = document.getElementById('hero-rotator');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (rotator && !reduce) {
    const lines = JSON.parse(rotator.dataset.lines || '[]') as string[];
    const hold = rotator.querySelector('.rotator-line');
    if (hold instanceof HTMLElement && lines.length > 1) {
      let index = 0;
      window.setInterval(() => {
        index = (index + 1) % lines.length;
        hold.classList.remove('is-in');
        void hold.offsetWidth;
        hold.textContent = lines[index];
        hold.classList.add('is-in');
      }, 2000);
    }
  }
</script>
