---
import fs from 'node:fs';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { asset, sitePath } from '../../lib/asset';
import { parseCaseStudy } from '../../lib/caseStudy';
import { firstParagraph } from '../../lib/excerpts';
import { renderMarkdown } from '../../lib/renderMarkdown';
import { splitCaseSections } from '../../lib/sections';
import { publishedWork } from '../../lib/work';

type Entry = CollectionEntry<'work'>;

export async function getStaticPaths() {
  const studies = publishedWork(await getCollection('work'));
  return studies.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
if (!entry.filePath) throw new Error(`Missing file for ${entry.id}`);
const body = parseCaseStudy(fs.readFileSync(entry.filePath, 'utf8')).body;
const data = entry.data;
const studies = publishedWork(await getCollection('work'));
const index = studies.findIndex((study) => study.id === entry.id);
const next = index >= 0 ? studies[index + 1] : undefined;
const sections = splitCaseSections(body);

function leadAndRest(markdown: string) {
  const stripped = markdown.replace(/^## +.+\n+/, '').trim();
  const parts = stripped.split(/\n\s*\n/);
  return {
    lead: firstParagraph(parts[0] ?? ''),
    rest: parts.slice(1).join('\n\n'),
  };
}

function slug(value: string) {
  return value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'section';
}

type Band =
  | { kind: 'text'; id: string; label: string; lead: string; rest: string; dark: boolean }
  | { kind: 'shots'; id: string; label: string; dark: boolean };

const bands: Band[] = [];
let dark = false;
let shotsPlaced = false;
for (const section of sections) {
  if (section.isResults && data.gallery.length > 0 && !shotsPlaced) {
    bands.push({ kind: 'shots', id: 'screens', label: 'Screens', dark });
    dark = !dark;
    shotsPlaced = true;
  }
  const heading = section.heading ?? 'Overview';
  const parts = leadAndRest(section.markdown);
  bands.push({
    kind: 'text',
    id: slug(heading),
    label: heading,
    lead: parts.lead,
    rest: parts.rest,
    dark,
  });
  dark = !dark;
}
if (!shotsPlaced && data.gallery.length > 0) {
  bands.push({ kind: 'shots', id: 'screens', label: 'Screens', dark });
  dark = !dark;
}
if (data.quotes.length > 0) {
  bands.push({ kind: 'text', id: 'notes', label: 'Notes', lead: '', rest: '', dark: false });
}

const menu = bands.filter((band, i, all) => all.findIndex((item) => item.id === band.id) === i);
const problem = firstParagraph(sections.find((section) => section.heading?.toLowerCase() === 'problem')?.markdown ?? '');
const outcome = firstParagraph(sections.find((section) => section.isResults)?.markdown ?? data.outcome);
const blurb = firstParagraph(sections.find((section) => section.heading?.toLowerCase() === 'context')?.markdown ?? body);
const description = `${data.outcome} A product design case study for ${data.client} by Omar Faruk.`;
const shareImage = /\.(png|jpe?g|webp)$/i.test(data.cover) ? asset(data.cover, base) : asset('/images/omar-headshot.jpg', base);
---

<Base title={data.title} description={description} image={shareImage} imageAlt={data.coverAlt || data.title} ogType="article">
  <article class="case-study">
    {
      data.coverType === 'video' ? (
        <video class="cs-video" src={asset(data.cover, base)} autoplay muted loop playsinline></video>
      ) : (
        <div class="cs-header" style={`background-image: url('${asset(data.cover, base)}')`} role="img" aria-label={data.coverAlt || data.title}></div>
      )
    }

    <div class="case-info">
      <div class="case-title">
        <h1>{data.title}</h1>
        <h2>{data.outcome}</h2>
      </div>
      <div class="case-blurb">
        {blurb ? <p class="blurb">{blurb}</p> : null}
        {
          (problem || outcome) && (
            <div class="col-2 case-split">
              {problem ? <div><h3>Problem</h3><p>{problem}</p></div> : null}
              {outcome ? <div><h3>Outcome</h3><p>{outcome}</p></div> : null}
            </div>
          )
        }
      </div>
      <div class="case-tools">
        {data.role ? <div><h3>Role</h3><p>{data.role}</p></div> : null}
        {data.timeline ? <div><h3>Timeline</h3><p>{data.timeline}</p></div> : null}
        {data.client ? <div><h3>Client</h3><p>{data.client}</p></div> : null}
      </div>
    </div>

    {
      menu.length > 1 && (
        <nav class="scroll-menu" aria-label="Case study sections">
          {menu.map((band) => (
            <a href={`#${band.id}`}>
              <div class="ss-item" data-section-link={band.id}>{band.label}</div>
            </a>
          ))}
        </nav>
      )
    }

    {
      bands.map((band) => {
        if (band.kind === 'shots') {
          return (
            <section class:list={['band', band.dark && 'band-dark']} id={band.id} data-section={band.id}>
              <div class="container-1200">
                <div class="case-section-title col-2">
                  <div>
                    <h2>{band.label}</h2>
                    <h2 class="title-ghost" aria-hidden="true"></h2>
                  </div>
                  <div><p>Final screens from the work.</p></div>
                </div>
                <div class="shot-grid">
                  {data.gallery.map((image) => (
                    <figure>
                      <img src={asset(image.src, base)} alt={image.alt} />
                      {image.caption ? <figcaption>{image.caption}</figcaption> : null}
                    </figure>
                  ))}
                </div>
              </div>
            </section>
          );
        }
        if (band.id === 'notes') {
          return (
            <section class="band" id="notes" data-section="notes">
              <div class="container-1200">
                <div class="case-section-title col-2">
                  <div>
                    <h2>Notes</h2>
                    <h2 class="title-ghost" aria-hidden="true"></h2>
                  </div>
                  <div><p>What people on the project said.</p></div>
                </div>
                {data.quotes.map((quote) => (
                  <blockquote class="bp-quote">
                    <h2>"{quote.text}"</h2>
                    {quote.by ? <p>{quote.by}</p> : null}
                  </blockquote>
                ))}
              </div>
            </section>
          );
        }
        return (
          <section class:list={['band', band.dark && 'band-dark']} id={band.id} data-section={band.id}>
            <div class="container-1200">
              <div class="case-section-title col-2">
                <div>
                  <h2>{band.label}</h2>
                  <h2 class="title-ghost" aria-hidden="true"></h2>
                </div>
                <div>{band.lead ? <p>{band.lead}</p> : null}</div>
              </div>
              {band.rest ? <div class="case-prose" set:html={renderMarkdown(band.rest, base)} /> : null}
            </div>
          </section>
        );
      })
    }

    <div class="container-1200 study-next">
      <a href={sitePath('/#work', base)}>All work</a>
      {next ? <a href={sitePath(`/work/${next.id}/`, base)}>Next, {next.data.title}</a> : <span></span>}
    </div>
  </article>
</Base>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.scroll-menu a')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  const setActive = (id: string) => {
    links.forEach((link) => {
      const item = link.querySelector('.ss-item');
      item?.classList.toggle('is-active', item.getAttribute('data-section-link') === id);
    });
  };
  if (sections[0]) setActive(sections[0].id);
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target.id) setActive(visible.target.id);
      },
      { rootMargin: '-30% 0px -45% 0px', threshold: [0.15, 0.4] },
    );
    sections.forEach((section) => observer.observe(section));
  }
  links.forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.getAttribute('href')?.slice(1);
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      event.preventDefault();
      const top = target.getBoundingClientRect().top + window.scrollY - 20;
      window.scrollTo({ top, behavior: 'smooth' });
      setActive(target.id);
    });
  });
</script>
