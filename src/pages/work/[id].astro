---
import fs from 'node:fs';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { asset, sitePath } from '../../lib/asset';
import { parseCaseStudy } from '../../lib/caseStudy';
import { renderMarkdown } from '../../lib/renderMarkdown';
import { splitCaseSections } from '../../lib/sections';
import { publishedWork } from '../../lib/work';

type Entry = CollectionEntry<'work'>;

export async function getStaticPaths() {
  const studies = publishedWork(await getCollection('work'));
  return studies.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
if (!entry.filePath) throw new Error(`Missing file for ${entry.id}`);
const body = parseCaseStudy(fs.readFileSync(entry.filePath, 'utf8')).body;
const data = entry.data;

type Block = { type: 'prose'; html: string } | { type: 'gallery' } | { type: 'quotes' };
const blocks: Block[] = [];
let placedGallery = false;
let placedQuotes = false;
for (const section of splitCaseSections(body)) {
  if (section.isResults && !placedGallery) {
    blocks.push({ type: 'gallery' });
    placedGallery = true;
  }
  const html = renderMarkdown(section.markdown, base);
  if (html.trim()) blocks.push({ type: 'prose', html });
  if (section.isResults && !placedQuotes) {
    blocks.push({ type: 'quotes' });
    placedQuotes = true;
  }
}
if (!placedGallery) blocks.push({ type: 'gallery' });
if (!placedQuotes) blocks.push({ type: 'quotes' });

const description = `${data.outcome} A product design case study for ${data.client} by Omar Faruk.`;
const shareImage = /\.(png|jpe?g|webp)$/i.test(data.cover)
  ? asset(data.cover, base)
  : asset('/images/omar-headshot.jpg', base);
---

<Base title={data.outcome || data.title} description={description} image={shareImage} imageAlt={data.coverAlt || data.outcome} ogType="article">
  <article class="case">
    <div class="container">
      <a class="back" href={sitePath('/#work', base)}>All work</a>
      {
        data.cover && (
          <div class="cover">
            {data.coverType === 'video' ? (
              <video src={asset(data.cover, base)} controls playsinline>
                <p>{data.coverAlt}</p>
              </video>
            ) : (
              <img src={asset(data.cover, base)} alt={data.coverAlt} width="1600" height="1000" />
            )}
          </div>
        )
      }
      <p class="eyebrow">{data.client}</p>
      <h1>{data.outcome || data.title}</h1>
      {
        data.tags.length > 0 && (
          <ul class="tags" style="margin-top: 18px;">
            {data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }
      <dl class="meta">
        <div>
          <dt>Role</dt>
          <dd>{data.role}</dd>
        </div>
        <div>
          <dt>Timeline</dt>
          <dd>{data.timeline}</dd>
        </div>
        <div>
          <dt>Client</dt>
          <dd>{data.client}</dd>
        </div>
      </dl>
      {
        blocks.map((block) => {
          if (block.type === 'prose') return <div class="prose" set:html={block.html} />;
          if (block.type === 'gallery' && data.gallery.length > 0) {
            return (
              <section aria-labelledby="screens-title">
                <h2 id="screens-title">Final screens</h2>
                <ul class="gallery">
                  {data.gallery.map((image) => (
                    <li>
                      <figure>
                        <img src={asset(image.src, base)} alt={image.alt} width="1600" height="1200" loading="lazy" />
                        {image.caption ? <figcaption>{image.caption}</figcaption> : null}
                      </figure>
                    </li>
                  ))}
                </ul>
              </section>
            );
          }
          if (block.type === 'quotes' && data.quotes.length > 0) {
            return (
              <div class="quote-grid">
                {data.quotes.map((quote) => (
                  <figure class="quote">
                    <blockquote>
                      <p>{quote.text}</p>
                    </blockquote>
                    {quote.by ? <figcaption>{quote.by}</figcaption> : null}
                  </figure>
                ))}
              </div>
            );
          }
          return null;
        })
      }
    </div>
  </article>
</Base>
